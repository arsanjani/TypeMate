<Window x:Class="TypeMate.Core.Notifications.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ToastList" ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Margin="12"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="card" Background="#1A1D2E" CornerRadius="12" Margin="0,0,0,8" MaxWidth="380">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#4A5568" Opacity="0.6"/>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.50" BlurRadius="24" ShadowDepth="4"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>

                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="icon" Grid.Column="0"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE9CE;"/>
                                        <Setter Property="Foreground" Value="#6366F1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Success">
                                                <Setter Property="Text" Value="&#xE9CE;"/>
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                <Setter Property="Text" Value="&#xE7BA;"/>
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                                <Setter Property="Text" Value="&#xE7E3;"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="Segoe UI" FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F7FAFC" Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="13"
                                    Height="30" Width="30" Padding="0"
                                    VerticalAlignment="Top"
                                    Background="#4A5568" Foreground="#FFFFFF"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="OnDismissClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FFFFFF18"/>
                                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>


                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
