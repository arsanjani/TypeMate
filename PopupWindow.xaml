<Window x:Class="TypeMate.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeMate - Text Editor" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    
    <Window.Resources>
        <!-- MUI-inspired Color Palette -->
        <SolidColorBrush x:Key="PrimaryMain" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#42A5F5"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#1565C0"/>
        <SolidColorBrush x:Key="SecondaryMain" Color="#DC004E"/>
        <SolidColorBrush x:Key="SecondaryLight" Color="#FF5983"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#9A0036"/>
        <SolidColorBrush x:Key="BackgroundPaper" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BackgroundDefault" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>
        <SolidColorBrush x:Key="DividerColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SuccessMain" Color="#2E7D32"/>
        <SolidColorBrush x:Key="ErrorMain" Color="#D32F2F"/>
        
        <!-- MUI-inspired Button Styles -->
        <Style x:Key="ContainedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" 
                                                  Opacity="0.2" 
                                                  ShadowDepth="2" 
                                                  BlurRadius="4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryDark}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" 
                                                          Opacity="0.3" 
                                                          ShadowDepth="4" 
                                                          BlurRadius="8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryDark}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" 
                                                          Opacity="0.1" 
                                                          ShadowDepth="1" 
                                                          BlurRadius="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BDBDBD"/>
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Material Design Card-like appearance -->
    <Border Background="{StaticResource BackgroundPaper}" 
            CornerRadius="8" 
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              Opacity="0.1" 
                              ShadowDepth="8" 
                              BlurRadius="16"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Text Editor" 
                           FontFamily="Segoe UI"
                           FontSize="24" 
                           FontWeight="Regular" 
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Edit your selected text and insert it back" 
                           FontFamily="Segoe UI"
                           FontSize="14" 
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Grid.Row="1" 
                       Height="1" 
                       Fill="{StaticResource DividerColor}" 
                       Margin="0,0,0,16"/>

            <!-- Text Editor Section -->
            <Border Grid.Row="2" 
                    Background="White"
                    BorderBrush="{StaticResource DividerColor}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect Color="Black" 
                                      Opacity="0.05" 
                                      ShadowDepth="1" 
                                      BlurRadius="3"/>
                </Border.Effect>
                <TextBox x:Name="TextEditor"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="16"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Foreground="{StaticResource TextPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionBrush="{StaticResource PrimaryLight}"/>
            </Border>

            <!-- Action Buttons Section -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button x:Name="AiButton"
                        Style="{StaticResource OutlinedButton}"
                        Width="140"
                        Height="36"
                        Margin="0,0,12,0"
                        Click="AiButton_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✨ AI" Margin="0,0,6,0"/>
                            <TextBlock Text="▼"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AiContextMenu">
                            <MenuItem Header="Easy read" Click="AiMenu_EasyRead_Click"/>
                            <MenuItem Header="Witty" Click="AiMenu_Witty_Click"/>
                            <MenuItem Header="Formal" Click="AiMenu_Formal_Click"/>
                            <MenuItem Header="Summarise" Click="AiMenu_Summarise_Click"/>
                            <MenuItem Header="Expand" Click="AiMenu_Expand_Click"/>
                            <MenuItem Header="LinkedIn post" Click="AiMenu_LinkedIn_Click"/>
                            <MenuItem Header="English to Farsi" Click="AiMenu_EnglishToFarsi_Click"/>
                            <MenuItem Header="Convert to AI prompt" Click="AiMenu_PromptOptimizer_Click"/>
                            <Separator/>
                            <MenuItem Header="Set API Key…" Click="AiMenu_SetApiKey_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="InsertButton"
                        Content="✅ Insert"
                        Style="{StaticResource ContainedButton}"
                        Width="100"
                        Height="36"
                        Margin="0,0,12,0"
                        Click="InsertButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource TextButton}"
                        Width="80"
                        Height="36"
                        Click="CancelButton_Click"/>
            </StackPanel>

            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Grid.RowSpan="5">
                <Border Background="#80000000"/>
                <Border Width="260" Padding="20" CornerRadius="8" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Rewriting with AI…" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="6" Foreground="{StaticResource PrimaryMain}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
