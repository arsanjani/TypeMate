<Window x:Class="TypeMate.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Configuration" Width="540" Height="620" MinHeight="400" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.RenderTransform>
        <TranslateTransform x:Name="DialogTranslate"/>
    </Window.RenderTransform>
    <Window.Opacity>0</Window.Opacity>

    <!-- Main Glassmorphic Container -->
    <Border Background="#FFFFFFF0" 
            CornerRadius="20" 
            Margin="16"
            BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFFFFF"/>
                <GradientStop Offset="0.5" Color="#6366F140"/>
                <GradientStop Offset="1" Color="#06B6D440"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#6366F1" Opacity="0.2" BlurRadius="50" ShadowDepth="0"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Icon -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Gradient Icon Circle -->
                <Grid Height="56" Width="56" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <Ellipse Fill="#F1F5F9" StrokeThickness="2">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#6366F1"/>
                                <GradientStop Offset="1" Color="#06B6D4"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <TextBlock Text="🔑" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="AI Configuration" 
                           FontFamily="Segoe UI Variable" 
                           FontSize="24" 
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock x:Name="HelperText"
                           Text="Configure your AI provider settings. Credentials are stored securely." 
                           FontFamily="Segoe UI Variable" 
                           FontSize="13"
                           Foreground="#64748B" 
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Scrollable Content -->
            <ScrollViewer x:Name="SettingsScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Opacity" Value="0.5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb"
                                                       Background="#94A3B8"
                                                       BorderThickness="0">
                                                    <Thumb.Style>
                                                        <Style TargetType="Thumb">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Thumb.Style>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,8,8">

                    <!-- Ollama Info Banner -->
                    <Border x:Name="OllamaBanner"
                            Visibility="Hidden"
                            Background="#DCFCE760" 
                            CornerRadius="10" 
                            Padding="14,12" 
                            Margin="0,0,0,14"
                            BorderThickness="1"
                            BorderBrush="#86EFAC80">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅ " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Ollama — local AI models (no API key needed)" 
                                       FontFamily="Segoe UI Variable" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#166534" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Security Notice -->
                    <Border x:Name="SecurityNotice"
                            Background="#EEF2FF80"
                            CornerRadius="10"
                            Padding="14,12"
                            Margin="0,0,0,16"
                            BorderThickness="1"
                            BorderBrush="#A5B4FC80">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Your API key is encrypted and stored only on this device."
                                       FontFamily="Segoe UI Variable"
                                       FontSize="12"
                                       Foreground="#4338CA"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Provider Selection -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource InputLabel}">
                            <Run Text="🏢 "/>
                            <Run Text="AI Provider"/>
                        </TextBlock>
                        <ComboBox x:Name="ProviderComboBox" 
                                  Height="48"
                                  Padding="16,8"
                                  FontFamily="Segoe UI Variable"
                                  FontSize="14"
                                  BorderThickness="1.5"
                                  BorderBrush="#E2E8F0"
                                  Background="#FFFFFFF0"
                                  Foreground="#0F172A"
                                  SelectionChanged="ProviderComboBox_SelectionChanged">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <Border x:Name="Border" 
                                                            Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="12">
                                                        <Grid>
                                                            <ContentPresenter x:Name="PART_ContentHost"
                                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                              Margin="{TemplateBinding Padding}"
                                                                              VerticalAlignment="Center"/>
                                                            <ToggleButton x:Name="DropDownToggle" 
                                                                          Focusable="False" 
                                                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                          ClickMode="Press"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          HorizontalAlignment="Right"
                                                                          Width="36">
                                                                <Path Data="M7 10l5 5 5-5z" Fill="#6366F1" 
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </ToggleButton>
                                                        </Grid>
                                                    </Border>
                                                    <Popup x:Name="PART_Popup" 
                                                           Placement="Bottom" 
                                                           IsOpen="{TemplateBinding IsDropDownOpen}" 
                                                           AllowsTransparency="True" 
                                                           Focusable="False" 
                                                           PopupAnimation="Slide">
                                                        <Border Background="#FFFFFFF0" 
                                                                BorderBrush="#E2E8F0" 
                                                                BorderThickness="1" 
                                                                CornerRadius="12"
                                                                Margin="0,4,0,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#6366F1" Opacity="0.1" BlurRadius="20" ShadowDepth="4"/>
                                                            </Border.Effect>
                                                            <ScrollViewer x:Name="DropDownScrollViewer">
                                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock x:Name="ProviderHelperText"
                                   Text="Select your preferred AI provider" 
                                   Style="{StaticResource HelperText}" 
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- OpenAI Compatible: Base URL -->
                    <StackPanel x:Name="BaseUrlPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Text="🌐  Base URL" Style="{StaticResource InputLabel}"/>
                        <Grid MouseEnter="FieldBox_MouseEnter" MouseLeave="FieldBox_MouseLeave">
                            <Border x:Name="BaseUrlBoxBorder"
                                    Height="48"
                                    Background="#FFFFFFF0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"/>
                            <TextBox x:Name="BaseUrlBox"
                                      Padding="16,12"
                                      FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Foreground="#0F172A"
                                      GotKeyboardFocus="FieldBox_GotFocus"
                                      LostKeyboardFocus="FieldBox_LostFocus"/>
                        </Grid>
                        <TextBlock Text="e.g., https://api.openai.com"
                                   Style="{StaticResource HelperText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- API Key Field -->
                    <StackPanel x:Name="ApiKeyPanel" Margin="0,0,0,16">
                        <TextBlock x:Name="ApiKeyLabelText" Text="🔐  API Key" Style="{StaticResource InputLabel}"/>
                        <Grid x:Name="ApiKeyBoxGrid" MouseEnter="ApiKeyBox_MouseEnter" MouseLeave="ApiKeyBox_MouseLeave">
                            <Border x:Name="ApiKeyBoxBorder"
                                    Height="48"
                                    Background="#FFFFFFF0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"/>
                            <PasswordBox x:Name="ApiKeyBox" 
                                          Padding="16,12"
                                          FontFamily="Segoe UI Variable"
                                          FontSize="14"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Foreground="#0F172A"
                                          PasswordChar="●"
                                          GotKeyboardFocus="ApiKeyBox_GotFocus"
                                          LostKeyboardFocus="ApiKeyBox_LostFocus"/>
                        </Grid>
                    </StackPanel>

                    <!-- Model Name Field -->
                    <StackPanel x:Name="ModelPanel" Margin="0,0,0,16">
                        <TextBlock Text="🤖  Model Name" Style="{StaticResource InputLabel}"/>
                        <Grid MouseEnter="ModelBox_MouseEnter" MouseLeave="ModelBox_MouseLeave">
                            <Border x:Name="ModelBoxBorder"
                                    Height="48"
                                    Background="#FFFFFFF0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"/>
                            <TextBox x:Name="ModelBox"
                                      Padding="16,12"
                                      FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Foreground="#0F172A"
                                      GotKeyboardFocus="ModelBox_GotFocus"
                                      LostKeyboardFocus="ModelBox_LostFocus"/>
                        </Grid>
                        <TextBlock x:Name="ModelHelperText"
                                   Text="Enter the model identifier for your provider"
                                   Style="{StaticResource HelperText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- OpenAI Compatible: Model ID -->
                    <StackPanel x:Name="CompatibleModelPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Text="🤖  Model ID" Style="{StaticResource InputLabel}"/>
                        <Grid MouseEnter="FieldBox_MouseEnter" MouseLeave="FieldBox_MouseLeave">
                            <Border x:Name="CompatibleModelBoxBorder"
                                    Height="48"
                                    Background="#FFFFFFF0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"/>
                            <TextBox x:Name="CompatibleModelBox"
                                      Padding="16,12"
                                      FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Foreground="#0F172A"
                                      GotKeyboardFocus="FieldBox_GotFocus"
                                      LostKeyboardFocus="FieldBox_LostFocus"/>
                        </Grid>
                        <TextBlock Text="The model identifier exposed by your endpoint"
                                   Style="{StaticResource HelperText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- OpenAI Compatible: Context Window -->
                    <StackPanel x:Name="ContextWindowPanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Text="📏  Context Window Size" Style="{StaticResource InputLabel}"/>
                        <Grid MouseEnter="FieldBox_MouseEnter" MouseLeave="FieldBox_MouseLeave">
                            <Border x:Name="ContextWindowBoxBorder"
                                    Height="48"
                                    Background="#FFFFFFF0"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"/>
                            <TextBox x:Name="ContextWindowBox"
                                      Padding="16,12"
                                      FontFamily="Segoe UI Variable"
                                      FontSize="14"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Foreground="#0F172A"
                                      GotKeyboardFocus="FieldBox_GotFocus"
                                      LostKeyboardFocus="FieldBox_LostFocus"/>
                        </Grid>
                        <TextBlock Text="Maximum tokens per request (e.g., 8192). Optional."
                                   Style="{StaticResource HelperText}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="✕  Cancel"
                        Style="{StaticResource GhostButton}"
                        Height="38" Padding="16,0"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"/>
                <Button Content="💾  Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        Height="38" Padding="24,0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
