<Window x:Class="TypeMate.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TypeMate"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="HyperlinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource GlassBrush}" 
            BorderBrush="{DynamicResource GlassBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16"
            Padding="32">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" ShadowDepth="0" BlurRadius="40"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Icon -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Background="{DynamicResource PrimaryBrush}" 
                        CornerRadius="20" Padding="20" Margin="0,0,0,16">
                    <TextBlock Text="TM" FontSize="32" FontWeight="Bold" 
                               Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="TypeMate" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TitleBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="AI-Powered Writing Companion" FontSize="14" 
                           Foreground="{DynamicResource SubtitleBrush}" 
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1">
                <!-- Version -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📦" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Version" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SubtitleBrush}"/>
                            <TextBlock Text="1.0.0" FontSize="14" 
                                       Foreground="{DynamicResource TitleBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shortcuts -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌨️" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Keyboard Shortcuts" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SubtitleBrush}"/>
                             <TextBlock x:Name="HotkeyTextBlock" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,4,0,0">
                                 <Run FontWeight="SemiBold"/><Run Foreground="{DynamicResource SubtitleBrush}" Text="&#xD;&#xA;"/>
                                 <Run Foreground="{DynamicResource SubtitleBrush}" Text="Capture"/>
                             </TextBlock>
                             <TextBlock FontSize="13" Foreground="{DynamicResource TitleBrush}">
                                 <Run Text="Click Tray Icon&#xD;&#xA;"/>
                                 <Run Foreground="{DynamicResource SubtitleBrush}" Text="Freestyle Editor"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GitHub -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌐" FontSize="20" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Open Source" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SubtitleBrush}"/>
                            <TextBlock FontSize="13" Foreground="{DynamicResource SubtitleBrush}" Margin="0,2,0,0">
                                <Run Text="Visit us on GitHub: "/>
                                <Hyperlink x:Name="GitHubLink" Click="GitHubLink_Click" 
                                           NavigateUri="https://github.com/arsanjani/TypeMate">
                                    github.com/arsanjani/TypeMate
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="Close" Margin="0,24,0,0"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0" Padding="32,10" FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand" Click="Close_Click" HorizontalAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>