<Window x:Class="TypeMate.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TypeMate"
        Width="500" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA"
        MinWidth="500" MinHeight="420">
    
    <Window.Resources>
        <!-- MUI Material Design Colors -->
        <SolidColorBrush x:Key="PrimaryMain" Color="#1976D2"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>
        <SolidColorBrush x:Key="Surface" Color="White"/>
        <SolidColorBrush x:Key="DividerColor" Color="#E0E0E0"/>
        
        <!-- MUI Button Style -->
        <Style x:Key="ContainedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink Style -->
        <Style x:Key="HyperlinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Foreground" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Content -->
    <Border Background="{StaticResource Surface}" CornerRadius="8" Margin="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              Opacity="0.1" 
                              ShadowDepth="8" 
                              BlurRadius="16"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="TypeMate" 
                           FontFamily="Segoe UI"
                           FontSize="24" 
                           FontWeight="Medium" 
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="AI-powered writing companion" 
                           FontFamily="Segoe UI"
                           FontSize="14" 
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Grid.Row="1" 
                       Height="1" 
                       Fill="{StaticResource DividerColor}" 
                       Margin="0,0,0,20"/>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <TextBlock FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource TextPrimary}"
                           LineHeight="22"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap">
                    <Run Text="• Press Ctrl+Alt+R to capture selected text and open the editor"/>
                    <LineBreak/>
                    <Run Text="• Click the tray icon to open the Freestyle Editor"/>
                </TextBlock>

                <TextBlock FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource TextPrimary}"
                           TextWrapping="Wrap">
                    <Run Text="Visit us on GitHub: "/>
                    <Hyperlink x:Name="GitHubLink"
                               Style="{StaticResource HyperlinkStyle}"
                               Click="GitHubLink_Click"
                               NavigateUri="https://github.com/arsanjani/TypeMate"
                               TargetName="_blank">
                        <Run Text="github.com/arsanjani/TypeMate"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <Run Text="Click the link above to visit our GitHub repository for source code, issues, and updates."/>
                </TextBlock>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Close" 
                        Style="{StaticResource ContainedButton}" 
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
