<Window x:Class="TypeMate.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Configuration" Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Window.Resources>
        <!-- MUI Material Design Colors and Theme -->
        <SolidColorBrush x:Key="PrimaryMain" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#1565C0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>
        <SolidColorBrush x:Key="DividerColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="Surface" Color="White"/>
        <SolidColorBrush x:Key="OnSurface" Color="#424242"/>
        <SolidColorBrush x:Key="Outline" Color="#C4C7C5"/>
        
        <!-- MUI TextField Style -->
        <Style x:Key="OutlinedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryMain}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MUI PasswordBox Style -->
        <Style x:Key="OutlinedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryMain}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MUI ComboBox Style -->
        <Style x:Key="OutlinedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <Grid>
                                    <ContentPresenter x:Name="PART_ContentHost" 
                                                      Margin="{TemplateBinding Padding}" 
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>
                                    <ToggleButton x:Name="DropDownToggle" 
                                                  Grid.Column="1" 
                                                  Focusable="False" 
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Right"
                                                  Width="30">
                                        <Path Data="M7 10l5 5 5-5z" Fill="{StaticResource TextSecondary}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Border Background="White" 
                                        BorderBrush="{StaticResource Outline}" 
                                        BorderThickness="1" 
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" 
                                                          Opacity="0.1" 
                                                          BlurRadius="8" 
                                                          ShadowDepth="2" 
                                                          Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" 
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryMain}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- MUI Contained Button -->
        <Style x:Key="ContainedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- MUI Text Button -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Content with MUI Dialog Structure -->
    <Border Background="{StaticResource Surface}" CornerRadius="8" Margin="0">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog Title -->
            <TextBlock x:Name="DialogTitle"
                       Text="AI Configuration" 
                       FontFamily="Segoe UI" 
                       FontSize="20" 
                       FontWeight="Medium"
                       Foreground="{StaticResource TextPrimary}" 
                       Margin="0,0,0,20"/>

            <!-- Dialog Content -->
            <StackPanel Grid.Row="1">
                <!-- Helper Text -->
                <TextBlock x:Name="HelperText"
                           Text="Configure your OpenAI API settings. Your credentials are stored securely on this device." 
                           FontFamily="Segoe UI" 
                           FontSize="14"
                           Foreground="{StaticResource TextSecondary}" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Ollama Info Text (hidden by default) -->
                <TextBlock x:Name="OllamaInfoText"
                           Text="These models run locally via Ollama (localhost:11434). No API key required." 
                           FontFamily="Segoe UI" 
                           FontSize="12"
                           Foreground="#388E3C" 
                           TextWrapping="Wrap"
                           Visibility="Hidden"
                           Margin="0,0,0,8"/>

                <!-- API Key Field -->
                <StackPanel x:Name="ApiKeyPanel" Margin="0,0,0,16">
                    <TextBlock Text="API Key *" 
                               FontFamily="Segoe UI" 
                               FontSize="12" 
                               FontWeight="Medium"
                               Foreground="{StaticResource OnSurface}" 
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ApiKeyBox" 
                                 Style="{StaticResource OutlinedPasswordBox}" 
                                 FontSize="14"/>
                </StackPanel>

                <!-- Model Selection Field -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Model" 
                               FontFamily="Segoe UI" 
                               FontSize="12" 
                               FontWeight="Medium"
                               Foreground="{StaticResource OnSurface}" 
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="ModelComboBox" 
                              Style="{StaticResource OutlinedComboBox}"
                              SelectionChanged="ModelComboBox_SelectionChanged">
                        <!-- OpenAI Models -->
                        <ComboBoxItem Content="gpt-4o-mini"/>
                        <ComboBoxItem Content="gpt-4o"/>
                        <ComboBoxItem Content="gpt-4-turbo"/>
                        <ComboBoxItem Content="gpt-3.5-turbo"/>
                        <ComboBoxItem Content="o1-mini"/>
                        <ComboBoxItem Content="o1-preview"/>
                        <!-- Ollama Models -->
                        <Separator/>
                        <TextBlock Text="── Ollama Models ──" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="14,4,0,0"/>
                         <ComboBoxItem Content="nemotron-3-nano:4b"/>
                         <ComboBoxItem Content="gemma4:latest"/>
                         <ComboBoxItem Content="qwen3.5:0.8b"/>
                         <ComboBoxItem Content="translategemma:4b"/>
                     </ComboBox>
                    <TextBlock x:Name="ModelHelperText"
                               Text="Select the model to use for text processing" 
                               FontFamily="Segoe UI" 
                               FontSize="11" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Dialog Actions -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,24,0,0">
                <Button Content="Cancel" 
                        Style="{StaticResource TextButton}" 
                        Click="Cancel_Click" 
                        Margin="0,0,8,0"/>
                <Button Content="Save" 
                        Style="{StaticResource ContainedButton}" 
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
